      "code": "\/\/ ==UserScript==\n\/\/ @name         NotmeMovies - Einthusan Session Helper\n\/\/ @namespace    notmevalo.movies\n\/\/ @version      1.1\n\/\/ @match        https:\/\/einthusan.tv\/*\n\/\/ @match        https:\/\/www.einthusan.tv\/*\n\/\/ @run-at       document-idle\n\/\/ ==\/UserScript==\n\n(function () {\n    'use strict';\n\n    const log = (...args) =>\n        console.log('[NotmeMovies Einthusan]', ...args);\n\n    function authenticated() {\n        const selectors = [\n            'a[href*=\"logout\"]',\n            'a[href*=\"signout\"]',\n            'a[href*=\"\/account\"]',\n            'a[href*=\"\/profile\"]',\n            '.logout',\n            '.signout'\n        ];\n\n        if (selectors.some(s => document.querySelector(s))) {\n            return true;\n        }\n\n        const text =\n            (document.body?.innerText || '').toLowerCase();\n\n        return (\n            text.includes('logout') ||\n            text.includes('log out') ||\n            text.includes('sign out')\n        );\n    }\n\n    function looksLikeLogin(el) {\n        const text =\n            (el?.innerText || el?.textContent || '')\n                .toLowerCase();\n\n        return (\n            text.includes('please login') &&\n            text.includes('password') &&\n            (\n                text.includes('forgot password') ||\n                text.includes('log in with google')\n            )\n        );\n    }\n\n    function removeStaleLoginOverlay() {\n        if (!authenticated()) {\n            return;\n        }\n\n        const elements =\n            document.querySelectorAll(\n                'div, section, aside, form'\n            );\n\n        for (const el of elements) {\n            if (!looksLikeLogin(el)) continue;\n\n            let node = el;\n\n            for (let i = 0; i < 7 && node; i++) {\n                const style = getComputedStyle(node);\n                const rect = node.getBoundingClientRect();\n\n                if (\n                    style.position === 'fixed' ||\n                    (\n                        rect.width > innerWidth * 0.65 &&\n                        rect.height > innerHeight * 0.45\n                    )\n                ) {\n                    node.style.setProperty(\n                        'display',\n                        'none',\n                        'important'\n                    );\n\n                    log('Removed stale authenticated login overlay');\n                    break;\n                }\n\n                node = node.parentElement;\n            }\n        }\n\n        document.documentElement.style.removeProperty('overflow');\n        document.body?.style.removeProperty('overflow');\n    }\n\n    function resumePlayer() {\n        if (!authenticated()) return;\n\n        const videos = document.querySelectorAll('video');\n\n        for (const video of videos) {\n            if (\n                video.currentSrc?.includes('einthusan.io') ||\n                video.src?.includes('einthusan.io')\n            ) {\n                video.play().catch(() => {});\n            }\n        }\n    }\n\n    function fix() {\n        removeStaleLoginOverlay();\n        resumePlayer();\n    }\n\n    fix();\n\n    const observer = new MutationObserver(() => {\n        clearTimeout(window.__notmeSessionHelper);\n        window.__notmeSessionHelper =\n            setTimeout(fix, 150);\n    });\n\n    observer.observe(document.documentElement, {\n        subtree: true,\n        childList: true\n    });\n})();",
