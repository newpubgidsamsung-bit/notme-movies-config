  "scripts": [
    {
      "id": "youtube-ad-block-youtube-music",
      "name": "youtube ad block",
      "siteId": "youtube-music",
      "code": "\/\/ ==UserScript==\n\/\/ @name         Notme YouTube Music Ad Skipper\n\/\/ @namespace    notmevalo\n\/\/ @version      1.0\n\/\/ @description  Skip\/mute YouTube Music video ads and remove common ad\/promo overlays\n\/\/ @match        https:\/\/music.youtube.com\/*\n\/\/ @run-at       document-start\n\/\/ ==\/UserScript==\n\n(() => {\n    'use strict';\n\n    const TAG = '[Notme YTM]';\n    let lastAdState = false;\n\n    const skipSelectors = [\n        '.ytp-ad-skip-button',\n        '.ytp-ad-skip-button-modern',\n        '.ytp-skip-ad-button',\n        'button.ytp-ad-skip-button',\n        'button.ytp-ad-skip-button-modern',\n        '[id*=\"skip-button\"] button',\n        '.videoAdUiSkipButton'\n    ];\n\n    const removableSelectors = [\n        '.ytp-ad-overlay-container',\n        '.ytp-ad-text-overlay',\n        '.ytp-ad-player-overlay',\n        'ytmusic-mealbar-promo-renderer',\n        'ytmusic-guide-entry-renderer[is-promoted]',\n        '[class*=\"ad-overlay\"]'\n    ];\n\n    function getPlayer() {\n        return document.querySelector('#movie_player');\n    }\n\n    function getVideo() {\n        return document.querySelector('video');\n    }\n\n    function isAdPlaying() {\n        const player = getPlayer();\n\n        return !!(\n            player &&\n            (\n                player.classList.contains('ad-showing') ||\n                player.classList.contains('ad-interrupting') ||\n                player.classList.contains('ytp-ad-overlay-open')\n            )\n        );\n    }\n\n    function clickSkipButtons() {\n        for (const selector of skipSelectors) {\n            const elements = document.querySelectorAll(selector);\n\n            for (const el of elements) {\n                try {\n                    if (\n                        el &&\n                        !el.disabled &&\n                        el.offsetParent !== null\n                    ) {\n                        el.click();\n                    }\n                } catch (_) {}\n            }\n        }\n    }\n\n    function removeAdOverlays() {\n        for (const selector of removableSelectors) {\n            document.querySelectorAll(selector).forEach(el => {\n                try {\n                    el.remove();\n                } catch (_) {}\n            });\n        }\n    }\n\n    function skipCurrentAd() {\n        if (!isAdPlaying()) {\n            if (lastAdState) {\n                const video = getVideo();\n\n                if (video) {\n                    try {\n                        video.muted = false;\n                        video.playbackRate = 1;\n                    } catch (_) {}\n                }\n            }\n\n            lastAdState = false;\n            return;\n        }\n\n        lastAdState = true;\n\n        const video = getVideo();\n\n        if (video) {\n            try {\n                \/\/ Prevent ad audio while we are skipping it.\n                video.muted = true;\n\n                \/\/ Run skippable countdowns extremely quickly.\n                video.playbackRate = 16;\n\n                \/\/ If the ad duration is already known, jump close to the end.\n                if (\n                    Number.isFinite(video.duration) &&\n                    video.duration > 1\n                ) {\n                    const target = Math.max(\n                        video.currentTime,\n                        video.duration - 0.15\n                    );\n\n                    if (target > video.currentTime) {\n                        video.currentTime = target;\n                    }\n                }\n            } catch (_) {}\n        }\n\n        clickSkipButtons();\n        removeAdOverlays();\n    }\n\n    function run() {\n        try {\n            skipCurrentAd();\n            clickSkipButtons();\n            removeAdOverlays();\n        } catch (e) {\n            console.debug(TAG, e);\n        }\n    }\n\n    \/\/ YouTube changes the player DOM dynamically.\n    const observer = new MutationObserver(run);\n\n    function start() {\n        if (!document.documentElement) {\n            requestAnimationFrame(start);\n            return;\n        }\n\n        observer.observe(document.documentElement, {\n            childList: true,\n            subtree: true,\n            attributes: true,\n            attributeFilter: ['class', 'style', 'hidden']\n        });\n\n        \/\/ Backup polling because some player state changes don't mutate\n        \/\/ the elements our observer happens to see.\n        setInterval(run, 250);\n\n        run();\n    }\n\n    start();\n})();",
      "enabled": true
    },
